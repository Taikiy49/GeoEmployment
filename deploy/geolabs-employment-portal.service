[Unit]
Description=Geolabs Employment Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/geolabs-employment-portal
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=-/etc/geolabs-employment-portal.env
ExecStart=/usr/bin/node server/ec2-server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/geolabs-employment-portal

[Install]
WantedBy=multi-user.target
