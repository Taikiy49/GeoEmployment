{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "tenantName": {
      "type": "string"
    },
    "tenantDomain": {
      "type": "string"
    },
    "planName": {
      "type": "string",
      "default": "Professional"
    },
    "monthlyRate": {
      "type": "number",
      "default": 20
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "past_due",
        "cancelled",
        "trial"
      ],
      "default": "active"
    },
    "billingEmail": {
      "type": "string"
    },
    "subscriptionStartDate": {
      "type": "string",
      "format": "date"
    },
    "nextBillingDate": {
      "type": "string",
      "format": "date"
    },
    "maxUsers": {
      "type": "number",
      "default": 10
    },
    "maxActiveRequisitions": {
      "type": "number",
      "default": 50
    },
    "features": {
      "type": "object",
      "properties": {
        "resumeParsing": {
          "type": "boolean",
          "default": true
        },
        "emailNotifications": {
          "type": "boolean",
          "default": true
        },
        "pdfGeneration": {
          "type": "boolean",
          "default": true
        },
        "multiTenant": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenantName",
    "billingEmail"
  ]
}