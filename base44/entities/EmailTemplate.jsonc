{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name (e.g., 'Interview Invitation')"
    },
    "stageKey": {
      "type": "string",
      "enum": [
        "under_review",
        "phone_screen",
        "interview",
        "offer",
        "hired",
        "rejected",
        "withdrawn",
        ""
      ],
      "description": "If set, this template is used automatically when a candidate moves to this stage"
    },
    "type": {
      "type": "string",
      "enum": [
        "stage_update",
        "interview_invitation",
        "rejection",
        "offer",
        "general"
      ],
      "description": "Template category"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line. Use {{firstName}}, {{position}}, {{stageLabel}} as variables."
    },
    "body": {
      "type": "string",
      "description": "Email body (plain text message shown inside the styled template). Use {{firstName}}, {{lastName}}, {{position}}, {{stageLabel}} as variables."
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    }
  },
  "required": [
    "name",
    "type",
    "subject",
    "body"
  ]
}